"""terrain_cache.py=================Lokaler Cache fuer OpenStreetMap-Gelaendeabfragen (Overpass API), damitTerrainFeatureSet/OSM.py nicht bei jedem einzelnen Simulationsschritt liveabgefragt werden muss.Warum das noetig ist (siehe Recherche-Ergebnis zur Maplibre/Simulation-Optimierung): Die oeffentliche Overpass-API hat nachweislich Rate-Limitsund wiederkehrende Stabilitaetsprobleme. Bei einer Simulation mit vielenSchritten (und pro Schritt mehreren Kandidatenrichtungen) waere das sonstder Flaschenhals bzw. Absturzpunkt des Systems.Wichtig (Update nach echtem Testlauf 25.08.2026): Overpass hat beischnellen, direkt aufeinanderfolgenden Anfragen ohne eigenen User-Agentmit HTTP 406 ("Not Acceptable") geantwortet - vermutlich eineBot-/Abuse-Schutzmassnahme des Servers. Dieses Modul schickt daher NICHTmehr ueber OSM.py's rohen requests.post(), sondern:  - mit einem eindeutigen User-Agent-Header (von Overpass empfohlen)  - mit einer kleinen Pause vor jeder echten Anfrage (Selbst-Drosselung)  - mit Wiederholungsversuchen (steigende Wartezeit) bei einzelnen Fehlern  - mit einem "Circuit Breaker": nach mehreren Fehlern IN FOLGE wird die    Terrain-Abfrage fuer den Rest des Laufs automatisch abgeschaltet    (Simulation laeuft dann einfach ohne Gelaende-Gewichtung weiter,    statt sich an hunderten Fehlversuchen aufzuhaengen)Update 21.09.2026 - Offline-Betrieb: Mit prefetch_terrain.py kann dasgesamte Kameragebiet EINMALIG vorab geladen werden. Innerhalb eines sovorberechneten Gebiets stellt get_features() NIE eine Internet-Anfrage -fehlender Eintrag bedeutet dort "nachweislich keine Merkmale". DieLive-Abfrage unten ist nur noch Rueckfall fuer Punkte ausserhalb.Funktionsweise (Cache): Koordinaten werden auf ein Raster gerundet(Standard ca. 150m Kantenlaenge), damit nahegelegene Simulationsschrittedenselben Cache-Eintrag wiederverwenden statt jedes Mal neu abzufragen.Ergebnisse landen dauerhaft in SQLite."""import jsonimport osimport sqlite3import timeimport requests_HERE = os.path.dirname(os.path.abspath(__file__))_SIM_DIR = os.path.join(_HERE, "bear_simulation")DEFAULT_CACHE_DB = os.path.join(_SIM_DIR, "data", "terrain_cache.db")# Rasterweite in Grad (~150m in Mitteleuropa/Japan). Kleiner = praeziser,# aber mehr Overpass-Anfragen; groesser = weniger Anfragen, groebere Aufloesung.GRID_SIZE_DEG = 0.0015OVERPASS_URL = "https://overpass-api.de/api/interpreter"# Unabhaengige Spiegelserver (andere Betreiber, andere Domains). Falls# overpass-api.de bei dir blockiert/nicht erreichbar ist (z.B. durch eine# Netzwerk-Firewall), sind diese trotzdem oft erreichbar, weil sie# technisch nichts miteinander zu tun haben.OVERPASS_URLS = [    "https://overpass-api.de/api/interpreter",    "https://overpass.kumi.systems/api/interpreter",    "https://overpass.private.coffee/api/interpreter",]# Overpass bittet Nutzer explizit um einen eindeutigen User-Agent statt des# generischen "python-requests/x.x" (das manche Server als Bot blocken).HEADERS = {"User-Agent": "OTH-Regensburg-WildlifeTracking/1.0 (Bachelorarbeit, nicht-kommerziell)"}# Standard-Tags, dieselben wie in Fabians OSM.py, damit die Ergebnisse# vergleichbar bleiben.DEFAULT_QUERY_ELEMENTS = {    "way": ["landuse", "natural", "waterway", "water", "aerialway", "geological", "railway",            "military", "highway", "place", "barrier", "leisure", "power"],    "node": ["landuse", "natural", "geological"],}MIN_SECONDS_BETWEEN_REQUESTS = 1.2  # Selbst-DrosselungCONSECUTIVE_FAILURES_BEFORE_GIVING_UP = 2  # war 3 - bei wiederholt unzuverlaessigem Netz schneller aufgebenREQUEST_TIMEOUT_SECONDS = 6  # war 15 - haelt den Schaden pro Fehlversuch kleinerclass TerrainCache:    """    WICHTIG: Der Circuit Breaker (_consecutive_failures / _giving_up) ist    bewusst auf KLASSENEBENE (nicht pro Instanz) gehalten. Grund: Bei    mehreren simulierten Baeren wird pro Baer potenziell eine eigene    TerrainCache()-Instanz erzeugt - waere der Zaehler an die Instanz    gebunden, wuerde er bei jedem neuen Baeren wieder bei 0 anfangen und    nie wirklich "aufgeben", selbst wenn das Netzwerk erkennbar nicht    erreichbar ist (genau das Verhalten, das im echten Testlauf am    15.09.2026 beobachtet wurde: >8 Fehlversuche ohne dass die    Abschalt-Meldung je kam). Klassenebene loest das unabhaengig davon,    wo/wie oft im Aufrufercode neue Instanzen erzeugt werden.    """    _consecutive_failures = 0    _giving_up = False    def __init__(self, db_path: str = DEFAULT_CACHE_DB, grid_size_deg: float = GRID_SIZE_DEG):        self.db_path = db_path        self.grid_size_deg = grid_size_deg        parent = os.path.dirname(db_path)        if parent:  # leerer Ordnername bei reinen Dateinamen wie "terrain_cache.db"            os.makedirs(parent, exist_ok=True)        self._init_db()        self._last_request_time = 0.0    @classmethod    def reset_circuit_breaker(cls):        """Setzt den Circuit Breaker manuell zurueck (z.B. fuer einen neuen,        unabhaengigen Simulationslauf oder zum Testen)."""        cls._consecutive_failures = 0        cls._giving_up = False    def _init_db(self):        """        Legt die Tabellen an. Ist die Datei beschaedigt (sqlite3.DatabaseError        "file is not a database"), wird der Cache deaktiviert statt die ganze        Anwendung abstuerzen zu lassen - die Simulation laeuft dann ohne        Gelaendegewichtung weiter, mit deutlichem Hinweis.        """        self._disabled = False        try:            conn = sqlite3.connect(self.db_path)            conn.execute("""                CREATE TABLE IF NOT EXISTS terrain_cache (                    lat_key REAL NOT NULL,                    lon_key REAL NOT NULL,                    radius INTEGER NOT NULL,                    features_json TEXT NOT NULL,                    cached_at REAL NOT NULL,                    PRIMARY KEY (lat_key, lon_key, radius)                )            """)            # Gebiete, die per prefetch_terrain.py vollstaendig vorab berechnet            # wurden. Innerhalb eines solchen Gebiets bedeutet "kein Eintrag"            # NICHT "unbekannt", sondern "hier ist nachweislich nichts" -> es            # wird dann NIE eine Internet-Anfrage gestellt.            conn.execute("""                CREATE TABLE IF NOT EXISTS prefetch_regions (                    min_lat_key REAL NOT NULL,                    min_lon_key REAL NOT NULL,                    max_lat_key REAL NOT NULL,                    max_lon_key REAL NOT NULL,                    radius INTEGER NOT NULL,                    created_at REAL NOT NULL                )            """)            conn.commit()            conn.close()        except sqlite3.DatabaseError as e:            self._disabled = True            print(f"  [Warnung] Gelaende-Cache '{self.db_path}' nicht lesbar ({e}). "                  f"Simulation laeuft ohne Gelaendegewichtung weiter. Datei umbenennen "                  f"und 'python prefetch_terrain.py' erneut ausfuehren.")        self._regions = [] if self._disabled else self._load_regions()        self._mem: dict = {}  # In-Memory-Nachschlagetabelle, spart SQLite-Zugriffe    def _load_regions(self) -> list[tuple]:        conn = sqlite3.connect(self.db_path)        rows = conn.execute(            "SELECT min_lat_key, min_lon_key, max_lat_key, max_lon_key, radius FROM prefetch_regions"        ).fetchall()        conn.close()        return rows    def _in_prefetched_region(self, lat_key: float, lon_key: float, radius: int) -> bool:        eps = 1e-9        for min_lat, min_lon, max_lat, max_lon, r in self._regions:            if r == radius and min_lat - eps <= lat_key <= max_lat + eps and min_lon - eps <= lon_key <= max_lon + eps:                return True        return False    def _grid_key(self, lat: float, lon: float) -> tuple[float, float]:        g = self.grid_size_deg        return (round(lat / g) * g, round(lon / g) * g)    def _throttle(self):        """Sorgt fuer mind. MIN_SECONDS_BETWEEN_REQUESTS Pause zwischen echten Anfragen."""        elapsed = time.time() - self._last_request_time        wait = MIN_SECONDS_BETWEEN_REQUESTS - elapsed        if wait > 0:            time.sleep(wait)        self._last_request_time = time.time()    def _query_overpass_raw(self, lat: float, lon: float, radius: int) -> dict:        """Baut die Overpass-QL-Anfrage (wie OSM.py) und schickt sie mit        eigenem User-Agent + Drosselung ab - probiert dabei nacheinander        alle unabhaengigen Spiegelserver aus OVERPASS_URLS durch, statt        denselben (evtl. blockierten) Server mehrfach zu wiederholen."""        query = "[out:json];\n("        for element_type, tags in DEFAULT_QUERY_ELEMENTS.items():            for tag in tags:                query += f"\n  {element_type}[\"{tag}\"](around:{radius},{lat},{lon});"        query += "\n);\nout body geom;"        last_error = None        for i, url in enumerate(OVERPASS_URLS):            self._throttle()            try:                resp = requests.post(url, data={"data": query}, headers=HEADERS, timeout=REQUEST_TIMEOUT_SECONDS)                if resp.status_code == 200:                    return resp.json()                last_error = f"{url} -> HTTP {resp.status_code}: {resp.text[:150]}"            except Exception as e:                last_error = f"{url} -> {e}"            if i < len(OVERPASS_URLS) - 1:                time.sleep(1)  # kurze Pause, dann direkt naechsten Spiegel probieren        raise RuntimeError(last_error)    def get_features(self, lat: float, lon: float, radius: int = 150) -> dict:        """        Liefert Terrain-Features (0/1-Flags pro OSM-Tag/-Wert) fuer eine        Koordinate - aus dem Cache, falls vorhanden, sonst live von Overpass        abgefragt (und danach gecacht). Bei wiederholten Fehlern schaltet        sich die Terrain-Abfrage fuer den Rest des Laufs automatisch ab        (Circuit Breaker) statt endlos weiter zu scheitern.        """        if getattr(self, "_disabled", False):            return {}        lat_key, lon_key = self._grid_key(lat, lon)        mem_key = (lat_key, lon_key, radius)        if mem_key in self._mem:            return self._mem[mem_key]        conn = sqlite3.connect(self.db_path)        row = conn.execute(            "SELECT features_json FROM terrain_cache WHERE lat_key=? AND lon_key=? AND radius=?",            (lat_key, lon_key, radius),        ).fetchone()        if row is not None:            conn.close()            features = json.loads(row[0])            self._mem[mem_key] = features            return features        # Vorab heruntergeladenes Gebiet (prefetch_terrain.py): kein Eintrag        # heisst hier "nachweislich keine relevanten Gelaendemerkmale" ->        # sofort leeres Ergebnis, KEINE Internet-Anfrage.        if self._in_prefetched_region(lat_key, lon_key, radius):            conn.close()            self._mem[mem_key] = {}            return {}        if TerrainCache._giving_up:            conn.close()            return {}        try:            raw = self._query_overpass_raw(lat, lon, radius)            TerrainCache._consecutive_failures = 0        except Exception as e:            TerrainCache._consecutive_failures += 1            print(f"  [Warnung] Overpass-Abfrage fehlgeschlagen ({lat:.5f},{lon:.5f}): {e}")            if TerrainCache._consecutive_failures >= CONSECUTIVE_FAILURES_BEFORE_GIVING_UP:                TerrainCache._giving_up = True                print(f"  [Hinweis] {CONSECUTIVE_FAILURES_BEFORE_GIVING_UP} Fehler in Folge - "                      f"Terrain-Abfrage wird fuer den Rest der Sitzung deaktiviert, auch fuer "                      f"neu erzeugte TerrainCache-Instanzen (Simulation laeuft ohne "                      f"Gelaende-Gewichtung weiter).")            conn.close()            return {}        features = self._to_flags(raw)        conn.execute(            "INSERT OR REPLACE INTO terrain_cache (lat_key, lon_key, radius, features_json, cached_at) "            "VALUES (?, ?, ?, ?, ?)",            (lat_key, lon_key, radius, json.dumps(features), time.time()),        )        conn.commit()        conn.close()        return features    @staticmethod    def _to_flags(raw: dict) -> dict:        """        Wandelt die rohe Overpass-Antwort (Tag -> Werteliste) in einfache        0/1-Flags um - sowohl fuer den Tag-Namen selbst (z.B. 'highway')        als auch fuer jeden gefundenen Wert (z.B. 'motorway', 'forest').        """        parsed = {tag: [] for element in DEFAULT_QUERY_ELEMENTS.values() for tag in element}        for element in raw.get("elements", []):            tags = element.get("tags", {})            for tag in parsed.keys():                if tag in tags:                    parsed[tag].append(tags[tag])        flags = {}        for tag, values in parsed.items():            if values:                flags[tag] = 1                for v in set(values):                    flags[v] = 1        return flags    def stats(self) -> dict:        conn = sqlite3.connect(self.db_path)        n = conn.execute("SELECT COUNT(*) FROM terrain_cache").fetchone()[0]        conn.close()        return {"cached_cells": n, "db_path": self.db_path}if __name__ == "__main__":    cache = TerrainCache()    print(f"Cache-Datenbank: {cache.db_path}")    print("Teste Abfrage (Fukushima-Region, Startkamera aus 2024Bear)...")    features = cache.get_features(37.476533, 139.963517, radius=150)    print(f"Gefundene Features: {features}")    print(f"\nCache-Statistik: {cache.stats()}")    print("Zweite Abfrage derselben Stelle (sollte aus Cache kommen, keine Netzwerk-Pause):")    t0 = time.time()    features2 = cache.get_features(37.476533, 139.963517, radius=150)    print(f"Dauer: {time.time()-t0:.3f}s (sollte nahe 0 sein)")    assert features == features2    print("OK - identisches Ergebnis aus dem Cache.")